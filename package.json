{
  "name": "cs2-demodesk",
  "version": "1.0.12",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "CS DemoDesk — Counter-Strike demo analysis desktop app",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:release": "npm run app:msix && node scripts/portable.mjs target/x86_64-pc-windows-msvc/release/demodesk.exe",
    "app:msix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/msix.ps1",
    "app:build": "tauri build --no-bundle && node scripts/portable.mjs",
    "test:privacy": "node scripts/check-repo-privacy.mjs",
    "test:core": "cargo test -p demodesk-core",
    "test:replay": "node --experimental-transform-types --test scripts/test-replay.mjs",
    "test:sync": "node --experimental-transform-types --test scripts/test-app-sync.mjs",
    "test:ui": "node --experimental-transform-types scripts/test-ui.mjs"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-virtual": "^3.14.11",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "bootstrap-icons": "^1.13.1",
    "date-fns": "^4.4.0",
    "driver.js": "^1.8.0",
    "echarts": "^6.1.0",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
